            flex-wrap: wrap;
            justify-content: center;
          }

          .container {
            padding: 3rem 1rem;
          }

          .hero h1 {
            font-size: 2rem;
          }

          .section-title {
            font-size: 1.5rem;
          }
        }
    </style>
</head>

