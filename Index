            font-size: 2.3rem;
          }

          .hero h2 {
            font-size: 1.25rem;
          }

          .hero p {
            font-size: 1rem;
          }

          .project-header {
            flex-direction: column;
            gap: 0.25rem;
          }
        }

        @media (max-width: 500px) {
          nav {
            flex-direction: column;
            gap: 1rem;
          }

